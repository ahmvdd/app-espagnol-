# Variables à définir dans Vercel (Settings > Environment Variables). Ne jamais les committer.
# DATABASE_URL est créée automatiquement quand tu ajoutes Neon (Storage > Neon).
DATABASE_URL=
# Longue chaîne aléatoire (32 caractères minimum) : openssl rand -base64 48
SESSION_SECRET=
ESPACE_1_NOM=
ESPACE_1_SECRET=
ESPACE_2_NOM=
ESPACE_2_SECRET=
ESPACE_3_NOM=
ESPACE_3_SECRET=
# Génération des diaporamas avec Gemini, dans le site (facultatif). Clé à créer sur aistudio.google.com
GEMINI_API_KEY=
# Modèle Gemini (facultatif, par défaut gemini-3.8-flash)
GEMINI_MODEL=
