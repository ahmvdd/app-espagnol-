{
  "name": "el-rincon-de-la-profe",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "node scripts/check-content.mjs && tsc && vite build && node scripts/build-pdfs.mjs",
    "preview": "vite preview --host",
    "test": "vitest run",
    "check": "node scripts/check-content.mjs",
    "deploy": "npm run build && npx -y wrangler@4.146.0 deploy"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "puppeteer-core": "^25.12.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/opendyslexic": "^5.3.0",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4"
  }
}
